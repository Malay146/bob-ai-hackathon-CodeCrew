# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file — it is in .gitignore.

# Postgres connection string (Prisma). A free Neon/Supabase/Railway instance
# works fine for the hackathon; local Postgres works too.
DATABASE_URL="postgresql://user:password@localhost:5432/waferlens"

# IBM watsonx.ai — optional. When set, the assistant (dashboard chat + the
# ask_bob/explain_lot/explain_risk MCP tools) uses watsonx to turn the
# computed statistics into natural-language explanations. Without it, the
# same endpoints fall back to a templated summary — the app is fully
# functional either way.
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
